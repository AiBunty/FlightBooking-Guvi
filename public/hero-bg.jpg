<svg width="400" height="200" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#a7e0ff"/>
      <stop offset="100%" stop-color="#e0f7fa"/>
    </linearGradient>
  </defs>
  <rect width="400" height="200" fill="url(#sky)"/>
  <ellipse cx="320" cy="160" rx="60" ry="18" fill="#fff" opacity="0.7"/>
  <ellipse cx="80" cy="170" rx="40" ry="12" fill="#fff" opacity="0.6"/>
  <ellipse cx="200" cy="180" rx="90" ry="22" fill="#fff" opacity="0.5"/>
  <g>
    <rect x="120" y="90" width="160" height="40" rx="20" fill="#fff" stroke="#0284c7" stroke-width="2"/>
    <polygon points="250,110 320,120 250,130" fill="#0284c7"/>
    <rect x="130" y="100" width="60" height="20" rx="8" fill="#bae6fd"/>
    <rect x="200" y="100" width="40" height="20" rx="8" fill="#bae6fd"/>
    <rect x="130" y="125" width="110" height="6" rx="3" fill="#e0f2fe"/>
  </g>
  <text x="200" y="60" text-anchor="middle" font-size="28" fill="#0284c7" font-family="sans-serif" font-weight="bold">SkyLedger</text>
  <text x="200" y="85" text-anchor="middle" font-size="16" fill="#0284c7" font-family="sans-serif">Book your next flight</text>
</svg>
